<aside id="app-sidebar" class="app-sidebar fixed inset-y-0 left-0 z-40 w-[290px] -translate-x-full overflow-y-auto lg:translate-x-0">
  <div class="flex min-h-full flex-col">
    <div class="sidebar-header px-4 pb-4 pt-5 lg:px-5">
      <div class="sidebar-brand-card rounded-3xl border border-white/70 bg-white/80 p-4 shadow-lg shadow-stone-200/40 backdrop-blur">
        <div class="sidebar-brand-row flex min-w-0 items-center gap-3">
          <div class="sidebar-logo flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sage/20 text-lg font-bold text-sageDark">
            ₿
          </div>
          <div class="sidebar-brand-text min-w-0">
            <h1 class="truncate text-base font-bold tracking-tight text-cocoa">Money Management</h1>
            <p class="text-xs text-muted">Finance made simple</p>
          </div>
        </div>

        <div class="sidebar-user-block mt-4 rounded-2xl border border-stone-200/80 bg-stone-50/80 px-3 py-2">
          <p class="text-[11px] uppercase tracking-[0.14em] text-muted">Signed in as</p>
          <p class="mt-1 text-sm font-semibold text-cocoa"><%= user ? user.full_name : 'User' %></p>
          <p class="truncate text-xs text-muted"><%= user && user.username ? '@' + user.username : '-' %></p>
          <p class="truncate text-xs text-muted"><%= user ? user.email : '-' %></p>
        </div>
      </div>
    </div>

    <nav class="flex-1 px-4 pb-5">
      <p class="sidebar-menu-heading px-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-muted/80">Main menu</p>
      <div class="mt-3 space-y-1.5">
        <a href="/dashboard" class="sidebar-link <%= current_path === '/dashboard' ? 'active' : '' %>" title="Dashboard">
          <span class="sidebar-icon">⌂</span>
          <span class="sidebar-label">Dashboard</span>
        </a>

        <a href="/transaction" class="sidebar-link <%= current_path.startsWith('/transaction') ? 'active' : '' %>" title="Transactions">
          <span class="sidebar-icon">↔</span>
          <span class="sidebar-label">Transactions</span>
        </a>

        <a href="/category" class="sidebar-link <%= current_path.startsWith('/category') ? 'active' : '' %>" title="Categories">
          <span class="sidebar-icon">◎</span>
          <span class="sidebar-label">Categories</span>
        </a>

        <a href="/subcategory" class="sidebar-link <%= current_path.startsWith('/subcategory') ? 'active' : '' %>" title="Subcategories">
          <span class="sidebar-icon">◌</span>
          <span class="sidebar-label">Subcategories</span>
        </a>

        <a href="/account" class="sidebar-link <%= current_path.startsWith('/account') ? 'active' : '' %>" title="Accounts">
          <span class="sidebar-icon">◫</span>
          <span class="sidebar-label">Accounts</span>
        </a>

        <a href="/budget" class="sidebar-link <%= current_path.startsWith('/budget') && !current_path.startsWith('/budget/recap') ? 'active' : '' %>" title="Budgets">
          <span class="sidebar-icon">▣</span>
          <span class="sidebar-label">Budgets</span>
        </a>

        <a href="/budget/recap" class="sidebar-link <%= current_path.startsWith('/budget/recap') ? 'active' : '' %>" title="Recap">
          <span class="sidebar-icon">▤</span>
          <span class="sidebar-label">Recap</span>
        </a>

        <a href="/report" class="sidebar-link <%= current_path.startsWith('/report') ? 'active' : '' %>" title="Report">
          <span class="sidebar-icon">▦</span>
          <span class="sidebar-label">Report</span>
        </a>

        <a href="/loan" class="sidebar-link <%= current_path.startsWith('/loan') ? 'active' : '' %>" title="Loans">
          <span class="sidebar-icon">¤</span>
          <span class="sidebar-label">Loans</span>
        </a>
      </div>

      <div class="sidebar-tip-card mt-7 rounded-3xl border border-white/70 bg-gradient-to-br from-white/95 via-white/80 to-[#f8f3ea] p-4 shadow-soft">
        <p class="text-sm font-semibold text-cocoa">Stay aware.</p>
        <p class="mt-2 text-xs leading-6 text-muted">
          Consistent daily tracking helps you make clearer financial decisions.
        </p>
      </div>
    </nav>

    <div class="border-t border-stone-200/70 px-4 py-4">
      <form action="/logout" method="POST">
        <button type="submit" class="sidebar-logout-btn" title="Logout">
          <span class="sidebar-icon">⤴</span>
          <span class="sidebar-label">Logout</span>
        </button>
      </form>
    </div>
  </div>
</aside>
