<%- include('pwa_meta') %>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Tailwind CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Plus Jakarta Sans', 'ui-sans-serif', 'system-ui']
        },
        colors: {
          cream: '#f7f3ec',
          latte: '#efe7da',
          sage: '#7b9a7e',
          sageDark: '#5f7a62',
          cocoa: '#2d2a26',
          muted: '#726c64',
          lineSoft: '#e8e2d8',
          cardSoft: '#fffdf9',
          sand: '#f4f1ea',
          paper: '#fcfbf8',
          pine: '#2f5d50',
          pineSoft: '#e8f3ef',
          accent: '#b07d4f'
        },
        boxShadow: {
          soft: '0 12px 30px rgba(41, 36, 31, 0.08)',
          cozy: '0 30px 70px rgba(41, 36, 31, 0.12)'
        },
        borderRadius: {
          '4xl': '2rem'
        }
      }
    }
