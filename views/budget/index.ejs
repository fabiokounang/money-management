<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/app_head') %>
</head>
<body class="min-h-screen bg-stone-50 text-stone-800">
    <%- include('../partials/sidebar') %>
    <div id="app-overlay" class="app-overlay lg:hidden"></div>

    <main id="budget-app-root" class="app-main px-4 py-4 sm:px-6 sm:py-6">
        <%- include('../partials/topbar') %>

        <%
            const safeBudgets = Array.isArray(budgets) ? budgets : [];
            const safeBudgetActualMap = budget_actual_map && typeof budget_actual_map === 'object'
                ? budget_actual_map
                : {};
            const safeSummaryStats = summary_stats || {
                total_budget_amount: 0,
                total_weekly_budget_amount: 0,
                total_monthly_budget_amount: 0,
                total_yearly_budget_amount: 0,
                total_custom_budget_amount: 0,
                monthly_equivalent_total: 0,
                total_actual_amount: 0,
                over_budget_count: 0
            };
            const safeFilters = filters || {
                search: '',
                period_type: '',
                is_active: -1
            };

            const currentPage = Number(page || 1);
            const perPage = Number(limit || 10);
            const totalRows = Number(total || 0);
            const totalPages = Number(total_pages || 1);
            const startRow = totalRows === 0 ? 0 : ((currentPage - 1) * perPage) + 1;
            const endRow = Math.min(currentPage * perPage, totalRows);
            const pageQuerySuffix = `&search=${encodeURIComponent(safeFilters.search || '')}&period_type=${encodeURIComponent(safeFilters.period_type || '')}&is_active=${encodeURIComponent(Number(safeFilters.is_active) === -1 ? '' : safeFilters.is_active)}`;

            const totalBudgetAmount = Number(safeSummaryStats.total_budget_amount || 0);
            const totalActualAmount = Number(safeSummaryStats.total_actual_amount || 0);
            const overBudgetCount = Number(safeSummaryStats.over_budget_count || 0);
            const totalWeeklyBudgetAmount = Number(safeSummaryStats.total_weekly_budget_amount || 0);
            const totalMonthlyBudgetAmount = Number(safeSummaryStats.total_monthly_budget_amount || 0);
            const totalYearlyBudgetAmount = Number(safeSummaryStats.total_yearly_budget_amount || 0);
            const totalCustomBudgetAmount = Number(safeSummaryStats.total_custom_budget_amount || 0);
            const monthlyEquivalentTotal = Number(safeSummaryStats.monthly_equivalent_total || 0);

            function formatCurrency(value) {
                return 'Rp\u00A0' + Number(value || 0).toLocaleString('id-ID');
            }

            function nominalMask() {
                return 'Rp ********';
            }

            function getStatusBadgeClass(isActive) {
                return Number(isActive) === 1
                    ? 'bg-emerald-100 text-emerald-700'
                    : 'bg-stone-200 text-stone-700';
            }

            function getStatusLabel(isActive) {
                return Number(isActive) === 1 ? 'Active' : 'Inactive';
            }

            function getUsageStatus(actual, budgetAmount) {
                if (actual > budgetAmount) {
                    return 'Over Budget';
                }

                if (actual === budgetAmount) {
                    return 'Budget Reached';
                }

                if (actual >= budgetAmount * 0.8) {
                    return 'Near Limit';
                }

                return 'Safe';
            }

            function getUsageStatusClass(actual, budgetAmount) {
                if (actual > budgetAmount) {
                    return 'bg-rose-100 text-rose-700';
                }

                if (actual === budgetAmount) {
                    return 'bg-amber-100 text-amber-700';
                }

                if (actual >= budgetAmount * 0.8) {
                    return 'bg-orange-100 text-orange-700';
                }

                return 'bg-emerald-100 text-emerald-700';
            }

            function getProgressWidth(actual, budgetAmount) {
                if (Number(budgetAmount) <= 0) {
                    return 0;
                }

                const percent = (Number(actual) / Number(budgetAmount)) * 100;
                return Math.min(Math.max(percent, 0), 100);
            }

            function getProgressBarClass(actual, budgetAmount) {
                if (actual > budgetAmount) {
                    return 'bg-rose-500';
                }

                if (actual >= budgetAmount * 0.8) {
                    return 'bg-amber-500';
                }

                return 'bg-emerald-500';
            }

            function getActualAmountByBudgetId(budgetId) {
                return Number(safeBudgetActualMap[String(budgetId)] || 0);
            }

            function getUsagePercent(actual, budgetAmount) {
                if (Number(budgetAmount) <= 0) {
                    return 0;
                }
                return Math.round((Number(actual) / Number(budgetAmount)) * 100);
            }

            function isOverBudget(actual, budgetAmount) {
                return Number(actual) > Number(budgetAmount);
            }

            function getOverBudgetAmount(actual, budgetAmount) {
                return Math.max(0, Number(actual) - Number(budgetAmount));
            }
        %>

        <% if (success_msg && success_msg.length > 0) { %>
            <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
                <%= success_msg[0] %>
            </div>
        <% } %>

        <% if (error_msg && error_msg.length > 0) { %>
            <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                <%= error_msg[0] %>
            </div>
        <% } %>

        <section class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-4">
            <div class="rounded-[28px] border border-stone-200/80 bg-white/90 p-5 shadow-xl shadow-stone-200/40">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-stone-500">Total Budgets</p>
                        <h3 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 whitespace-nowrap"><%= totalRows %></h3>
                        <p class="mt-2 text-xs text-stone-500">Filtered budget rows</p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-stone-200 text-lg font-semibold text-stone-700">
                        ◎
                    </div>
                </div>
            </div>

            <div class="rounded-[28px] border border-stone-200/80 bg-white/90 p-5 shadow-xl shadow-stone-200/40">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-stone-500">Total Budget</p>
                        <h3 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 whitespace-nowrap" data-budget-nominal>
                            <span class="budget-nominal-value"><%= formatCurrency(totalBudgetAmount) %></span>
                            <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                        </h3>
                        <p class="mt-2 text-xs text-emerald-600">Planned spending amount</p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-lg font-semibold text-emerald-700">
                        ↗
                    </div>
                </div>
            </div>

            <div class="rounded-[28px] border border-stone-200/80 bg-white/90 p-5 shadow-xl shadow-stone-200/40">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-stone-500">Actual Spending</p>
                        <h3 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 whitespace-nowrap" data-budget-nominal>
                            <span class="budget-nominal-value"><%= formatCurrency(totalActualAmount) %></span>
                            <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                        </h3>
                        <p class="mt-2 text-xs text-rose-600">Real expense inside budget periods</p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-100 text-lg font-semibold text-rose-700">
                        ↘
                    </div>
                </div>
            </div>

            <div class="rounded-[28px] border border-stone-200/80 bg-white/90 p-5 shadow-xl shadow-stone-200/40">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-stone-500">Over Budget</p>
                        <h3 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 whitespace-nowrap"><%= overBudgetCount %></h3>
                        <p class="mt-2 text-xs text-stone-500">Budgets exceeding limit</p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-lg font-semibold text-amber-700">
                        ▣
                    </div>
                </div>
            </div>
        </section>

        <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-5">
            <div class="rounded-3xl border border-stone-200/80 bg-white/90 p-4 shadow-lg shadow-stone-200/40">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Monthly Equivalent</p>
                <p class="mt-2 text-lg sm:text-xl font-bold text-stone-900 whitespace-nowrap" data-budget-nominal>
                    <span class="budget-nominal-value"><%= formatCurrency(monthlyEquivalentTotal) %></span>
                    <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                </p>
                <p class="mt-1 text-xs text-stone-500">Weekly x4.345 + Monthly + Yearly/12 + Custom</p>
            </div>

            <div class="rounded-3xl border border-stone-200/80 bg-white/90 p-4 shadow-lg shadow-stone-200/40">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Weekly Total</p>
                <p class="mt-2 text-lg sm:text-xl font-bold text-stone-900 whitespace-nowrap" data-budget-nominal>
                    <span class="budget-nominal-value"><%= formatCurrency(totalWeeklyBudgetAmount) %></span>
                    <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                </p>
            </div>

            <div class="rounded-3xl border border-stone-200/80 bg-white/90 p-4 shadow-lg shadow-stone-200/40">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Monthly Total</p>
                <p class="mt-2 text-lg sm:text-xl font-bold text-stone-900 whitespace-nowrap" data-budget-nominal>
                    <span class="budget-nominal-value"><%= formatCurrency(totalMonthlyBudgetAmount) %></span>
                    <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                </p>
            </div>

            <div class="rounded-3xl border border-stone-200/80 bg-white/90 p-4 shadow-lg shadow-stone-200/40">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Yearly Total</p>
                <p class="mt-2 text-lg sm:text-xl font-bold text-stone-900 whitespace-nowrap" data-budget-nominal>
                    <span class="budget-nominal-value"><%= formatCurrency(totalYearlyBudgetAmount) %></span>
                    <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                </p>
            </div>

            <div class="rounded-3xl border border-stone-200/80 bg-white/90 p-4 shadow-lg shadow-stone-200/40">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Custom Total</p>
                <p class="mt-2 text-lg sm:text-xl font-bold text-stone-900 whitespace-nowrap" data-budget-nominal>
                    <span class="budget-nominal-value"><%= formatCurrency(totalCustomBudgetAmount) %></span>
                    <span class="budget-nominal-placeholder font-semibold tracking-wider text-stone-500"><%= nominalMask() %></span>
                </p>
            </div>
        </section>

        <section class="mt-6 overflow-hidden rounded-[32px] border border-stone-200/80 bg-white/90 shadow-xl shadow-stone-200/50">
            <div class="border-b border-stone-100 bg-gradient-to-r from-emerald-50 via-white to-amber-50 px-5 py-5 sm:px-7 sm:py-6">
                <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                    <div>
                        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700 shadow-sm">
                            Budget Management
                        </div>
                        <h1 class="mt-4 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">
                            Manage Your Budgets
                        </h1>
                        <p class="mt-2 text-sm leading-7 text-stone-600">
                            Set and monitor spending budgets per category.
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <a
                            href="/budget/recap"
                            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-stone-200 bg-white px-5 py-3 text-sm font-semibold text-stone-800 shadow-sm transition hover:-translate-y-0.5 hover:border-stone-300"
                        >
                            <span>▤</span>
                            <span>Recap</span>
                        </a>
                        <a
                            href="/budget/create"
                            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-stone-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-stone-300/40 transition hover:-translate-y-0.5 hover:bg-emerald-700"
                        >
                            <span>＋</span>
                            <span>Add Budget</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="px-5 py-6 sm:px-7 sm:py-7">
                <form method="GET" action="/budget" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-5">
                    <div class="xl:col-span-2">
                        <label class="mb-2 block text-sm font-semibold text-stone-800">Search</label>
                        <input
                            type="text"
                            name="search"
                            value="<%= safeFilters.search || '' %>"
                            placeholder="Search by category..."
                            class="w-full rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                        >
                    </div>

                    <div>
                        <label class="mb-2 block text-sm font-semibold text-stone-800">Period Type</label>
                        <select
                            name="period_type"
                            class="w-full rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                        >
                            <option value="" <%= safeFilters.period_type === '' ? 'selected' : '' %>>All Periods</option>
                            <option value="weekly" <%= safeFilters.period_type === 'weekly' ? 'selected' : '' %>>Weekly</option>
                            <option value="monthly" <%= safeFilters.period_type === 'monthly' ? 'selected' : '' %>>Monthly</option>
                            <option value="yearly" <%= safeFilters.period_type === 'yearly' ? 'selected' : '' %>>Yearly</option>
                            <option value="custom" <%= safeFilters.period_type === 'custom' ? 'selected' : '' %>>Custom</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-2 block text-sm font-semibold text-stone-800">Status</label>
                        <select
                            name="is_active"
                            class="w-full rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                        >
                            <option value="" <%= Number(safeFilters.is_active) === -1 ? 'selected' : '' %>>All Status</option>
                            <option value="1" <%= Number(safeFilters.is_active) === 1 ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= Number(safeFilters.is_active) === 0 ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <div class="flex items-end gap-3">
                        <a
                            href="/budget"
                            class="inline-flex h-[50px] w-full items-center justify-center rounded-2xl border border-stone-200 bg-white px-5 text-sm font-semibold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:border-stone-300"
                        >
                            Clear Filter
                        </a>
                        <button
                            type="submit"
                            class="inline-flex h-[50px] w-full items-center justify-center rounded-2xl bg-stone-900 px-5 text-sm font-semibold text-white shadow-lg shadow-stone-300/30 transition hover:-translate-y-0.5 hover:bg-emerald-700"
                        >
                            Apply Filter
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section class="mt-6 overflow-hidden rounded-[32px] border border-stone-200/80 bg-white/90 shadow-xl shadow-stone-200/50">
            <div class="border-b border-stone-100 px-5 py-5 sm:px-7 sm:py-6">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-base font-semibold text-stone-900">Budget List</p>
                        <p class="mt-1 text-sm text-stone-500">Track budget amount, actual spending, and remaining balance.</p>
                    </div>
                    <div
                        class="inline-flex shrink-0 items-center gap-3 rounded-2xl border border-stone-200/90 bg-stone-50/90 px-4 py-2.5 shadow-sm"
                        role="group"
                        aria-label="Amount display"
                    >
                        <div class="min-w-0">
                            <p id="budget-nominal-toggle-label" class="text-sm font-semibold text-stone-800">Show amounts</p>
                            <p class="text-xs text-stone-500">Budget, actual, remaining</p>
                        </div>
                        <button
                            type="button"
                            id="budget-nominal-toggle"
                            role="switch"
                            aria-checked="true"
                            aria-labelledby="budget-nominal-toggle-label"
                            class="relative h-8 w-14 shrink-0 rounded-full bg-emerald-600 shadow-inner transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2"
                        >
                            <span
                                id="budget-nominal-toggle-knob"
                                class="pointer-events-none absolute left-1 top-1 h-6 w-6 rounded-full bg-white shadow-md transition-transform duration-200 ease-out translate-x-6"
                            ></span>
                            <span class="sr-only">Toggle amount visibility</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="hidden md:block overflow-x-auto">
                <table class="min-w-full border-collapse">
                    <thead>
                        <tr class="border-b border-stone-200 bg-stone-50">
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Category</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Budget</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Actual</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Remaining</th>
                            <th class="px-4 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500 min-w-[11rem]">Usage</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Period</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Status</th>
                            <th class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (safeBudgets.length === 0) { %>
                            <tr>
                                <td colspan="8" class="px-6 py-12 text-center text-sm text-stone-500">
                                    No budgets found for the current filter.
                                </td>
                            </tr>
                        <% } %>

                        <% safeBudgets.forEach((item) => { %>
                            <%
                                const actualAmount = getActualAmountByBudgetId(item.id);
                                const budgetAmount = Number(item.amount || 0);
                                const remainingAmount = budgetAmount - actualAmount;
                                const progressWidth = getProgressWidth(actualAmount, budgetAmount);
                                const usagePercent = getUsagePercent(actualAmount, budgetAmount);
                                const overBudget = isOverBudget(actualAmount, budgetAmount);
                                const overByAmount = getOverBudgetAmount(actualAmount, budgetAmount);
                            %>

                            <tr class="border-b border-stone-100 last:border-b-0 hover:bg-stone-50/70">
                                <td class="px-6 py-4 align-top">
                                    <p class="font-semibold text-stone-900"><%= item.category_name %></p>
                                    <p class="mt-1 text-xs text-stone-500"><%= item.note || 'No note' %></p>
                                </td>

                                <td class="px-6 py-4 text-sm font-semibold text-stone-900 whitespace-nowrap" data-budget-nominal>
                                    <span class="budget-nominal-value tabular-nums"><%= formatCurrency(budgetAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </td>

                                <td class="px-6 py-4 text-sm font-semibold text-stone-900 whitespace-nowrap" data-budget-nominal>
                                    <span class="budget-nominal-value tabular-nums"><%= formatCurrency(actualAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </td>

                                <td class="px-6 py-4 text-sm font-semibold whitespace-nowrap <%= remainingAmount < 0 ? 'text-rose-700' : 'text-emerald-700' %>" data-budget-nominal>
                                    <span class="budget-nominal-value tabular-nums"><%= formatCurrency(remainingAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </td>

                                <td class="min-w-[11rem] px-4 py-4 align-top">
                                    <div class="space-y-2">
                                        <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
                                            <span class="inline-flex max-w-full rounded-full px-2.5 py-0.5 text-[11px] font-semibold leading-tight <%= getUsageStatusClass(actualAmount, budgetAmount) %>" title="<%= getUsageStatus(actualAmount, budgetAmount) %>">
                                                <%= getUsageStatus(actualAmount, budgetAmount) %>
                                            </span>
                                            <span class="shrink-0 text-xs font-semibold tabular-nums <%= overBudget ? 'text-rose-700' : 'text-stone-500' %>">
                                                <%= usagePercent %>%
                                            </span>
                                        </div>
                                        <% if (overBudget) { %>
                                            <p class="text-[11px] font-medium leading-snug text-rose-700" data-budget-nominal>
                                                <span class="budget-nominal-value">Over by <%= formatCurrency(overByAmount) %></span>
                                                <span class="budget-nominal-placeholder">Over by <%= nominalMask() %></span>
                                            </p>
                                        <% } %>
                                        <div class="h-2 overflow-hidden rounded-full bg-stone-200">
                                            <div
                                                class="h-full rounded-full <%= getProgressBarClass(actualAmount, budgetAmount) %>"
                                                style="width: <%= progressWidth %>%"
                                            ></div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4 text-sm text-stone-500">
                                    <div class="capitalize"><%= item.period_type %></div>
                                    <div class="mt-1 text-xs">
                                        <%= item.start_date ? String(item.start_date).slice(0, 10) : '-' %>
                                        -
                                        <%= item.end_date ? String(item.end_date).slice(0, 10) : '-' %>
                                    </div>
                                </td>

                                <td class="px-6 py-4">
                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= getStatusBadgeClass(item.is_active) %>">
                                        <%= getStatusLabel(item.is_active) %>
                                    </span>
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-center gap-2">
                                        <a
                                            href="/budget/<%= item.id %>/edit"
                                            class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-xs font-semibold text-stone-700 transition hover:bg-stone-50"
                                        >
                                            Edit
                                        </a>

                                        <form action="/budget/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this budget?');">
                                            <button
                                                type="submit"
                                                class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100"
                                            >
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div id="budget-card-view" class="space-y-4 p-5 sm:p-6 md:hidden">
                <% if (safeBudgets.length === 0) { %>
                    <div class="rounded-[24px] border border-stone-200 bg-stone-50 p-6 text-center text-sm text-stone-500">
                        No budgets found for the current filter.
                    </div>
                <% } %>

                <% safeBudgets.forEach((item) => { %>
                    <%
                        const actualAmount = getActualAmountByBudgetId(item.id);
                        const budgetAmount = Number(item.amount || 0);
                        const remainingAmount = budgetAmount - actualAmount;
                        const progressWidth = getProgressWidth(actualAmount, budgetAmount);
                        const usagePercent = getUsagePercent(actualAmount, budgetAmount);
                        const overBudget = isOverBudget(actualAmount, budgetAmount);
                        const overByAmount = getOverBudgetAmount(actualAmount, budgetAmount);
                    %>

                    <article class="rounded-[28px] border border-stone-200 bg-white p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h3 class="text-base font-semibold text-stone-900"><%= item.category_name %></h3>
                                <p class="mt-1 text-sm text-stone-500"><%= item.note || 'No note' %></p>
                            </div>
                            <span class="shrink-0 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= getStatusBadgeClass(item.is_active) %>">
                                <%= getStatusLabel(item.is_active) %>
                            </span>
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-2">
                            <span class="inline-flex rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold capitalize text-stone-700">
                                <%= item.period_type %>
                            </span>
                            <span class="text-xs text-stone-500">
                                <%= item.start_date ? String(item.start_date).slice(0, 10) : '-' %>
                                –
                                <%= item.end_date ? String(item.end_date).slice(0, 10) : '-' %>
                            </span>
                        </div>

                        <div class="mt-4 space-y-2">
                            <div class="flex items-center justify-between gap-3 rounded-2xl bg-stone-50 px-3 py-2.5" data-budget-nominal>
                                <p class="text-xs font-medium text-stone-500">Budget</p>
                                <p class="text-sm font-semibold tabular-nums text-stone-900 whitespace-nowrap">
                                    <span class="budget-nominal-value"><%= formatCurrency(budgetAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </p>
                            </div>
                            <div class="flex items-center justify-between gap-3 rounded-2xl bg-stone-50 px-3 py-2.5" data-budget-nominal>
                                <p class="text-xs font-medium text-stone-500">Actual</p>
                                <p class="text-sm font-semibold tabular-nums text-stone-900 whitespace-nowrap">
                                    <span class="budget-nominal-value"><%= formatCurrency(actualAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </p>
                            </div>
                            <div class="flex items-center justify-between gap-3 rounded-2xl bg-stone-50 px-3 py-2.5" data-budget-nominal>
                                <p class="text-xs font-medium text-stone-500">Remaining</p>
                                <p class="text-sm font-semibold tabular-nums whitespace-nowrap <%= remainingAmount < 0 ? 'text-rose-700' : 'text-emerald-700' %>">
                                    <span class="budget-nominal-value"><%= formatCurrency(remainingAmount) %></span>
                                    <span class="budget-nominal-placeholder tracking-wider text-stone-500"><%= nominalMask() %></span>
                                </p>
                            </div>
                        </div>

                        <div class="mt-4 rounded-2xl border border-stone-100 bg-stone-50/90 p-3">
                            <div class="flex items-start justify-between gap-3">
                                <span class="inline-flex min-w-0 shrink rounded-full px-2.5 py-1 text-[11px] font-semibold leading-tight <%= getUsageStatusClass(actualAmount, budgetAmount) %>">
                                    <%= getUsageStatus(actualAmount, budgetAmount) %>
                                </span>
                                <span class="shrink-0 pl-2 pt-0.5 text-right text-xs font-semibold tabular-nums whitespace-nowrap <%= overBudget ? 'text-rose-700' : 'text-stone-600' %>">
                                    <%= usagePercent %>%
                                </span>
                            </div>
                            <% if (overBudget) { %>
                                <p class="mt-2 text-[11px] font-medium leading-snug text-rose-700" data-budget-nominal>
                                    <span class="budget-nominal-value">Over by <%= formatCurrency(overByAmount) %></span>
                                    <span class="budget-nominal-placeholder">Over by <%= nominalMask() %></span>
                                </p>
                            <% } else { %>
                                <p class="mt-2 text-[11px] text-stone-500"><%= usagePercent %>% of budget used</p>
                            <% } %>
                            <div class="mt-2.5 h-2.5 overflow-hidden rounded-full bg-stone-200">
                                <div
                                    class="h-full rounded-full <%= getProgressBarClass(actualAmount, budgetAmount) %>"
                                    style="width: <%= progressWidth %>%"
                                ></div>
                            </div>
                        </div>

                        <div class="mt-4 flex gap-2">
                            <a
                                href="/budget/<%= item.id %>/edit"
                                class="flex-1 rounded-xl border border-stone-200 bg-white px-3 py-3 text-center text-xs font-semibold text-stone-700"
                            >
                                Edit
                            </a>
                            <form action="/budget/<%= item.id %>?_method=DELETE" method="POST" class="flex-1" onsubmit="return confirm('Delete this budget?');">
                                <button
                                    type="submit"
                                    class="w-full rounded-xl border border-rose-200 bg-rose-50 px-3 py-3 text-xs font-semibold text-rose-700"
                                >
                                    Delete
                                </button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>

            <%- include('../partials/pagination_bar', {
                paginationCurrentPage: currentPage,
                paginationTotalPages: totalPages,
                paginationStartRow: startRow,
                paginationEndRow: endRow,
                paginationTotalRows: totalRows,
                paginationBasePath: '/budget',
                paginationQuerySuffix: pageQuerySuffix,
                paginationEntityLabel: 'budgets'
            }) %>
        </section>
    </main>

    <style>
        #budget-app-root .budget-nominal-placeholder {
            display: none;
        }

        #budget-app-root.budget-hide-nominals .budget-nominal-value {
            display: none;
        }

        #budget-app-root.budget-hide-nominals .budget-nominal-placeholder {
            display: inline;
        }

        #budget-nominal-toggle[aria-checked="false"] {
            background-color: #d6d3d1;
        }

        #budget-nominal-toggle[aria-checked="false"] #budget-nominal-toggle-knob {
            transform: translateX(0);
        }
    </style>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        const overlay = document.getElementById('app-overlay');

        if (sidebarToggle && sidebar && overlay) {
            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            });

            overlay.addEventListener('click', () => {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
            });
        }

        (function initBudgetNominalToggle() {
            const STORAGE_KEY = 'mm-budget-show-nominal';
            const root = document.getElementById('budget-app-root');
            const toggle = document.getElementById('budget-nominal-toggle');
            const knob = document.getElementById('budget-nominal-toggle-knob');
            const label = document.getElementById('budget-nominal-toggle-label');

            if (!root || !toggle) {
                return;
            }

            const readPreference = () => {
                try {
                    const stored = localStorage.getItem(STORAGE_KEY);
                    if (stored === '0') return false;
                    if (stored === '1') return true;
                } catch (_err) {
                    /* ignore */
                }
                return true;
            };

            const applyPreference = (showNominal) => {
                root.classList.toggle('budget-hide-nominals', !showNominal);
                toggle.setAttribute('aria-checked', showNominal ? 'true' : 'false');
                if (knob) {
                    knob.classList.toggle('translate-x-6', showNominal);
                    knob.classList.toggle('translate-x-0', !showNominal);
                }
                if (label) {
                    label.textContent = showNominal ? 'Show amounts' : 'Amounts masked';
                }
            };

            let showNominal = readPreference();
            applyPreference(showNominal);

            toggle.addEventListener('click', () => {
                showNominal = !showNominal;
                applyPreference(showNominal);
                try {
                    localStorage.setItem(STORAGE_KEY, showNominal ? '1' : '0');
                } catch (_err) {
                    /* ignore */
                }
            });
        })();
    </script>
</body>
</html>